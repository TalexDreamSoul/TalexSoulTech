{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "talexsoultech:guide_book",
        "model": {
          "type": "minecraft:model",
          "model": "talexsoultech:item/guide_book"
        }
      },
      {
        "when": "talexsoultech:guider_book",
        "model": {
          "type": "minecraft:model",
          "model": "talexsoultech:item/guider_book"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/book"
    }
  }
}
